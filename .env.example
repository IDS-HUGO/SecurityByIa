# Copia este archivo como .env. Nunca pongas claves reales en git.

# Token en claro que presenta el backend al proxy.
SECURITY_PROXY_TOKEN=replace-with-the-generated-token

# Debe contener el SHA-256 del mismo token de arriba.
PROXY_TOKENS=[{"id":"demo-triage","token_sha256":"replace-with-sha256","providers":["gemini"],"rate_limit_per_minute":150}]

# Solo el servicio proxy recibe las claves de proveedores.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite